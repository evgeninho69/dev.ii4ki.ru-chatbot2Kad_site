# 2KAD Chatbot Backend ─ environment variables

# ── LLM (Mistral AI) ──────────────────────────────────────────
# Get your key at https://console.mistral.ai → API Keys
MISTRAL_API_KEY=your_mistral_api_key_here
# Д�ступные: ministral-8b-latest (free), mistral-small-latest (paid),
