# 2KAD Chatbot Backend — environment variables

# ── LLM (Mistral AI) ────────────────────────────────────────────────────────
# Get your key at https://console.mistral.ai → API Keys
MISTRAL_API_KEY=your_mistral_api_key_here
# Доступные модели: mistral-small-latest, mistral-large-latest, mistral-medium-latest,
# open-mistral-7b, open-mixtral-8x7b, ministral-8b-latest
MISTRAL_MODEL=mistral-small-latest

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8765
LOG_LEVEL=INFO
